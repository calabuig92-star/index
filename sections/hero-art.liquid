<section class="hero-art{% if section.settings.image %} has-image{% endif %}">
  {%- if section.settings.image -%}
    <div class="hero-art__media media">
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2200 }} 2200w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    </div>
  {%- endif -%}
  <div class="container hero-art__inner">
    <div class="hero-art__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-heading__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="hero-art__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="hero-art__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- stylesheet -%}
.hero-art{position:relative;display:flex;align-items:flex-end;min-height:60vh;}
.hero-art:not(.has-image){min-height:auto;padding:calc(var(--spacing-section) * 1.2) 0;background:var(--color-bg-alt);align-items:center;}
.hero-art__media{position:absolute;inset:0;z-index:0;border-radius:0;}
.hero-art__media::after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(0deg, rgba(0,0,0,.45) 0%, rgba(0,0,0,0) 55%);
}
.hero-art__media img{width:100%;height:100%;object-fit:cover;}
.hero-art__inner{position:relative;z-index:1;width:100%;padding:3rem 20px;}
.hero-art.has-image .hero-art__content{color:#fff;max-width:560px;}
.hero-art.has-image .hero-art__content .section-heading__eyebrow{color:rgba(255,255,255,.8);}
.hero-art__content{max-width:640px;}
.hero-art__title{margin-bottom:.4em;}
.hero-art__text{margin-bottom:1.5em;font-size:1.05rem;}
.hero-art.has-image .hero-art__text{opacity:.92;}
@media (max-width:699px){
  .hero-art{min-height:75vh;}
}
{%- endstylesheet -%}

{% schema %}
{
  "name": "Hero — obra destacada",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Colección actual" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Obra que respira Mediterráneo" },
    { "type": "richtext", "id": "text", "label": "Texto breve", "default": "<p>Piezas originales y ediciones de fine art print, hechas con calma.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver la obra" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Hero — obra destacada" }]
}
{% endschema %}
