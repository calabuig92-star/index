<div class="cart-page section-padding">
  <div class="container">
    <h1>{{ 'general.cart.title' | t }}</h1>
    <div class="cart-page__layout" data-cart-page-content>
      {%- render 'cart-drawer-content', cart: cart, context: 'page' -%}
    </div>
  </div>
</div>

{%- stylesheet -%}
.cart-page h1{margin-bottom:2rem;}
.cart-items--page .cart-item{grid-template-columns:110px 1fr;padding-bottom:1.5rem;border-bottom:var(--border-width) solid var(--color-border);}
@media (min-width:800px){
  .cart-page__layout{display:grid;grid-template-columns:1fr 360px;gap:3rem;align-items:start;}
  .cart-page__layout > .cart-summary{position:sticky;top:2rem;}
}
{%- endstylesheet -%}

{%- javascript -%}
(function () {
  document.querySelectorAll('[data-cart-page-content]').forEach(function (content) {
    content.addEventListener('click', function (event) {
      var item = event.target.closest('[data-cart-item]');
      if (!item) return;
      var key = item.getAttribute('data-line-key');
      var valueEl = item.querySelector('[data-cart-qty-value]');

      if (event.target.closest('[data-cart-qty-increase]')) {
        window.CartAPI.changeByKey(key, parseInt(valueEl.textContent, 10) + 1);
      } else if (event.target.closest('[data-cart-qty-decrease]')) {
        window.CartAPI.changeByKey(key, parseInt(valueEl.textContent, 10) - 1);
      } else if (event.target.closest('[data-cart-remove]')) {
        window.CartAPI.changeByKey(key, 0);
      }
    });

    document.addEventListener('cart:updated', function (event) {
      if (event.detail && event.detail.drawerHTML) {
        content.innerHTML = event.detail.drawerHTML;
      }
    });
  });
})();
{%- endjavascript -%}

{% schema %}
{
  "name": "Carrito"
}
{% endschema %}
