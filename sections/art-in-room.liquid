<section class="art-in-room">
  <div class="art-in-room__media media media--landscape">
    {%- if section.settings.image -%}
      <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="1800" height="{{ 1800 | divided_by: section.settings.image.aspect_ratio | default: 1000 }}">
    {%- endif -%}
  </div>
  {%- if section.settings.heading != blank or section.settings.button_label != blank -%}
    <div class="art-in-room__caption">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--secondary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{%- stylesheet -%}
.art-in-room{position:relative;}
.art-in-room__caption{
  position:absolute;bottom:2rem;left:2rem;
  background:var(--color-surface);
  padding:1.5rem 1.75rem;
  max-width:320px;
  border-radius:var(--radius-image);
}
.art-in-room__caption h2{font-size:1.4rem;margin-bottom:.75em;}
@media (max-width:699px){
  .art-in-room__caption{position:static;max-width:none;margin-top:-4px;}
}
{%- endstylesheet -%}

{% schema %}
{
  "name": "El arte en el espacio",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de ambiente" },
    { "type": "text", "id": "heading", "label": "Título", "default": "La obra en el espacio" },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "El arte en el espacio" }]
}
{% endschema %}
