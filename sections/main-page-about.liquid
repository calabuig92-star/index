<article class="about-page">
  {%- if section.settings.image -%}
    <div class="about-page__hero media media--landscape">
      <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.image.alt | escape }}" loading="eager" fetchpriority="high" width="1800" height="{{ 1800 | divided_by: section.settings.image.aspect_ratio | default: 1000 }}">
    </div>
  {%- endif -%}

  <div class="container section-padding">
    {%- render 'breadcrumbs' -%}

    <div class="about-page__intro">
      <h1>{{ page.title }}</h1>
      <div class="about-page__anchor-text">{{ section.settings.anchor_text }}</div>
    </div>

    {%- if section.blocks.size > 0 -%}
      {%- assign pillars = section.blocks | where: 'type', 'pillar' -%}
      {%- assign values = section.blocks | where: 'type', 'value' -%}

      {%- if pillars.size > 0 -%}
        <div class="about-page__pillars">
          {%- for block in pillars -%}
            <div class="about-page__pillar" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if values.size > 0 -%}
        <div class="about-page__values bg-alt">
          {%- for block in values -%}
            <div class="about-page__value" {{ block.shopify_attributes }}>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="about-page__cta">
        <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</article>

{%- stylesheet -%}
.about-page__hero{margin-bottom:2.5rem;}
.about-page__intro{max-width:720px;margin:0 auto 3rem;text-align:center;}
.about-page__anchor-text{color:var(--color-text-muted);margin-top:1em;font-size:1.05rem;}
.about-page__pillars{display:grid;gap:2rem;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin-bottom:3rem;text-align:center;}
.about-page__pillar h3{font-size:1.2rem;}
.about-page__pillar p{color:var(--color-text-muted);margin:0;}
.about-page__values{display:grid;gap:1.75rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));padding:2.5rem;border-radius:var(--radius-image);margin-bottom:2.5rem;}
.about-page__value h4{margin-bottom:.4em;}
.about-page__value p{color:var(--color-text-muted);margin:0;}
.about-page__cta{text-align:center;}
{%- endstylesheet -%}

{% schema %}
{
  "name": "Página — Historia",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de cabecera (estudio/proceso)" },
    {
      "type": "richtext",
      "id": "anchor_text",
      "label": "Texto ancla de marca",
      "default": "<p>Quiénes somos, por qué hacemos lo que hacemos, y los tres pilares que sostienen cada pieza: estético, ético y emocional.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver el Journal" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pilar",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Estético" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    },
    {
      "type": "value",
      "name": "Valor",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Producción consciente" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
