{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'general.newsletter.heading' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'general.newsletter.text' | t
  endif
-%}
<section class="newsletter-section section-padding">
  <div class="container newsletter-section__inner">
    <h2>{{ heading }}</h2>
    <p class="newsletter-section__text">{{ text }}</p>
    {%- render 'newsletter-form', id: 'Home' -%}
  </div>
</section>

{%- stylesheet -%}
.newsletter-section__inner{max-width:520px;margin:0 auto;text-align:center;}
.newsletter-section__text{color:var(--color-text-muted);margin-bottom:1.75em;}
.newsletter-section__inner .newsletter-form__row{justify-content:center;}
{%- endstylesheet -%}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título" },
    { "type": "text", "id": "text", "label": "Texto" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
