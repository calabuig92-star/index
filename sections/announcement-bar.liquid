{%- if section.blocks.size > 0 -%}
<div class="announcement-bar" id="AnnouncementBar-{{ section.id }}" data-announcement-bar {% if section.settings.collapsible %}data-collapsible{% endif %}>
  <div class="container announcement-bar__inner">
    <div class="announcement-bar__messages" {% if section.blocks.size > 1 %}data-rotate{% endif %}>
      {%- for block in section.blocks -%}
        <div class="announcement-bar__message" {{ block.shopify_attributes }} {% unless forloop.first %}hidden{% endunless %}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            <span>{{ block.settings.text }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.collapsible -%}
      <button type="button" class="announcement-bar__close" data-announcement-close aria-label="{{ 'sections.announcement.close' | t }}">
        {%- render 'icon', name: 'close' -%}
      </button>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{%- stylesheet -%}
.announcement-bar{
  background:var(--color-text);
  color:var(--color-bg);
  font-size:.8rem;
  letter-spacing:.02em;
}
.announcement-bar__inner{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:1rem;
  padding:.6em 20px;
  position:relative;
  text-align:center;
  min-height:2.6em;
}
.announcement-bar__messages{flex:1;}
.announcement-bar__message a{text-decoration:underline;text-underline-offset:2px;}
.announcement-bar__close{
  position:absolute;
  right:16px;top:50%;
  transform:translateY(-50%);
  background:none;border:none;color:inherit;
  width:20px;height:20px;padding:0;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
}
.announcement-bar__close svg{width:14px;height:14px;}
.announcement-bar.is-hidden{display:none;}
{%- endstylesheet -%}

{%- javascript -%}
(function () {
  document.querySelectorAll('[data-announcement-bar]').forEach(function (bar) {
    var key = 'announcement-dismissed-' + bar.id;
    if (bar.hasAttribute('data-collapsible') && sessionStorage.getItem(key) === '1') {
      bar.classList.add('is-hidden');
      return;
    }
    var closeBtn = bar.querySelector('[data-announcement-close]');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        bar.classList.add('is-hidden');
        try { sessionStorage.setItem(key, '1'); } catch (e) {}
      });
    }
    var wrap = bar.querySelector('[data-rotate]');
    if (wrap) {
      var messages = wrap.querySelectorAll('.announcement-bar__message');
      if (messages.length > 1) {
        var index = 0;
        setInterval(function () {
          messages[index].hidden = true;
          index = (index + 1) % messages.length;
          messages[index].hidden = false;
        }, 5000);
      }
    }
  });
})();
{%- endjavascript -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "settings": [
    {
      "type": "checkbox",
      "id": "collapsible",
      "label": "Permitir cerrar el aviso",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Envío gratuito en pedidos superiores a 150€"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Barra de anuncios",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}
