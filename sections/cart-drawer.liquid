<div class="drawer drawer--cart" id="CartDrawer" data-cart-drawer hidden>
  <div class="drawer__overlay" data-cart-drawer-close></div>
  <div class="drawer__panel drawer__panel--right" role="dialog" aria-modal="true" aria-label="{{ 'general.cart.title' | t }}">
    <div class="drawer__header">
      <span class="drawer__title">{{ 'general.cart.title' | t }} ({{ cart.item_count }})</span>
      <button type="button" class="header__icon-btn" data-cart-drawer-close aria-label="{{ 'general.cart.close' | t }}">
        {%- render 'icon', name: 'close' -%}
      </button>
    </div>
    <div class="drawer__body" id="CartDrawer-Content" data-cart-drawer-content>
      {%- render 'cart-drawer-content', cart: cart, context: 'drawer' -%}
    </div>
  </div>
</div>

{%- stylesheet -%}
.drawer--cart .drawer__panel--right{left:auto;right:0;transform:translateX(100%);box-shadow:-8px 0 24px rgba(0,0,0,.08);}
.drawer--cart.is-open .drawer__panel--right{transform:translateX(0);}
.drawer__title{font-family:var(--font-heading-family);font-size:1.1rem;}
.drawer__body{padding:1.25rem;overflow-y:auto;flex:1;display:flex;flex-direction:column;}

.cart-items{list-style:none;display:flex;flex-direction:column;gap:1.25rem;flex:1;}
.cart-item{display:grid;grid-template-columns:80px 1fr;gap:1rem;}
.cart-item__media{border-radius:var(--radius-image);}
.cart-item__title{font-weight:600;display:block;margin-bottom:.2rem;}
.cart-item__variant{color:var(--color-text-muted);font-size:.85rem;margin:0 0 .4rem;}
.cart-item__price{margin-bottom:.6rem;}
.cart-item__controls{display:flex;align-items:center;justify-content:space-between;}
.cart-item__remove{background:none;border:none;padding:0;font-size:.8rem;color:var(--color-text-muted);cursor:pointer;}

.quantity-stepper{display:flex;align-items:center;border:var(--border-width) solid var(--color-border);border-radius:var(--radius-button);}
.quantity-stepper button{background:none;border:none;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--color-text);}
.quantity-stepper button svg{width:14px;height:14px;}
.quantity-stepper span{min-width:1.5em;text-align:center;font-size:.9rem;}

.cart-summary{border-top:var(--border-width) solid var(--color-border);padding-top:1.25rem;margin-top:1.25rem;display:flex;flex-direction:column;gap:.75rem;}
.cart-summary__row{display:flex;justify-content:space-between;font-weight:600;font-size:1.05rem;}
.cart-summary__note{font-size:.8rem;color:var(--color-text-muted);margin:0;}
.cart-empty{display:flex;flex-direction:column;align-items:center;gap:1rem;flex:1;justify-content:center;}
{%- endstylesheet -%}

{%- javascript -%}
(function () {
  var drawer = document.getElementById('CartDrawer');
  if (!drawer) return;
  var content = document.getElementById('CartDrawer-Content');

  function open() {
    drawer.hidden = false;
    requestAnimationFrame(function () { drawer.classList.add('is-open'); });
    document.body.style.overflow = 'hidden';
  }
  function close() {
    drawer.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(function () { drawer.hidden = true; }, 250);
  }
  document.addEventListener('cart-drawer:open', open);
  drawer.querySelectorAll('[data-cart-drawer-close]').forEach(function (el) {
    el.addEventListener('click', close);
  });

  content.addEventListener('click', function (event) {
    var item = event.target.closest('[data-cart-item]');
    if (!item) return;
    var key = item.getAttribute('data-line-key');
    var valueEl = item.querySelector('[data-cart-qty-value]');

    if (event.target.closest('[data-cart-qty-increase]')) {
      window.CartAPI.changeByKey(key, parseInt(valueEl.textContent, 10) + 1);
    } else if (event.target.closest('[data-cart-qty-decrease]')) {
      window.CartAPI.changeByKey(key, parseInt(valueEl.textContent, 10) - 1);
    } else if (event.target.closest('[data-cart-remove]')) {
      window.CartAPI.changeByKey(key, 0);
    }
  });

  document.addEventListener('cart:updated', function (event) {
    if (event.detail && event.detail.drawerHTML) {
      content.innerHTML = event.detail.drawerHTML;
    }
    if (event.detail && event.detail.cart && event.detail.cart.item_count > 0 && event.detail.openDrawer !== false) {
      open();
    }
  });
})();
{%- endjavascript -%}

{% schema %}
{
  "name": "Carrito (drawer)"
}
{% endschema %}
