{%- comment -%} Parámetro requerido: product {%- endcomment -%}
<div class="product-gallery" data-product-gallery>
  <div class="product-gallery__track" data-gallery-track>
    {%- for media in product.media -%}
      <div class="product-gallery__slide" data-gallery-slide data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}">
        {%- if media.media_type == 'image' -%}
          <img
            src="{{ media | image_url: width: 1200 }}"
            srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1800 }} 1800w"
            sizes="(min-width: 900px) 50vw, 100vw"
            alt="{{ media.alt | escape }}"
            width="{{ media.width }}"
            height="{{ media.height }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            {% if forloop.first %}fetchpriority="high"{% endif %}
          >
        {%- else -%}
          {{ media | media_tag }}
        {%- endif -%}
      </div>
    {%- else -%}
      <div class="product-gallery__slide media media--portrait"></div>
    {%- endfor -%}
  </div>

  {%- if product.media.size > 1 -%}
    <div class="product-gallery__dots" data-gallery-dots>
      {%- for media in product.media -%}
        <button type="button" class="product-gallery__dot{% if forloop.first %} is-active{% endif %}" data-gallery-goto="{{ forloop.index0 }}" aria-label="{{ 'accessibility.load_image_in_gallery' | t: index: forloop.index }}"></button>
      {%- endfor -%}
    </div>

    <div class="product-gallery__thumbs" data-gallery-thumbs>
      {%- for media in product.media -%}
        <button type="button" class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-gallery-goto="{{ forloop.index0 }}">
          {%- if media.media_type == 'image' -%}
            <img src="{{ media | image_url: width: 160 }}" alt="" loading="lazy" width="80" height="{{ 80 | divided_by: media.aspect_ratio | default: 100 }}">
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
