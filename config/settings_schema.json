        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 2
      },
      {
        "type": "range",
        "id": "borders_width",
        "label": "Grosor de bordes",
        "min": 0,
        "max": 4,
        "step": 1,
        "unit": "px",
        "default": 1
      },
      {
        "type": "range",
        "id": "image_radius",
        "label": "Redondeo de imágenes",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 0
      }
