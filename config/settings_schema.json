        "label": "URL de Facebook"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "URL de TikTok"
      }
    ]
  },
  {
    "name": "Analítica",
    "settings": [
      {
        "type": "paragraph",
