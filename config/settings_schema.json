[
  {
    "name": "theme_info",
    "theme_name": "Mediterráneo Editorial",
    "theme_version": "1.0.0",
    "theme_author": "Studio",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Logo y favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Ancho del logo",
        "min": 80,
        "max": 260,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Se recomienda una imagen cuadrada de al menos 32 x 32 px"
      }
    ]
  },
  {
    "name": "Colores",
    "settings": [
      {
        "type": "color",
        "id": "colors_background",
        "label": "Fondo principal",
        "default": "#F7F3EC"
      },
      {
        "type": "color",
        "id": "colors_background_alt",
        "label": "Fondo alterno (secciones)",
        "default": "#EFE9DD"
      },
      {
        "type": "color",
        "id": "colors_surface",
        "label": "Superficie (tarjetas, drawers)",
        "default": "#FBF8F2"
      },
      {
        "type": "color",
        "id": "colors_text",
        "label": "Texto principal",
        "default": "#2E2A24"
      },
      {
        "type": "color",
        "id": "colors_text_muted",
        "label": "Texto secundario",
        "default": "#71685A"
      },
      {
        "type": "color",
        "id": "colors_accent",
        "label": "Acento (precios, CTA)",
        "default": "#AE6A44"
      },
      {
        "type": "color",
        "id": "colors_secondary",
        "label": "Secundario (badges)",
        "default": "#7C8B6C"
      },
      {
        "type": "color",
        "id": "colors_border",
        "label": "Bordes y líneas",
        "default": "#DED5C3"
      },
      {
        "type": "color",
        "id": "colors_button_text",
        "label": "Texto sobre botones rellenos",
        "default": "#F7F3EC"
      }
    ]
  },
  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Tipografía de títulos",
        "default": "playfair_display_n4"
      },
      {
        "type": "range",
        "id": "type_header_scale",
        "label": "Tamaño de títulos",
        "min": 100,
        "max": 150,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Tipografía de texto",
        "default": "work_sans_n4"
      },
      {
        "type": "range",
        "id": "type_body_scale",
        "label": "Tamaño de texto",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Diseño",
    "settings": [
      {
        "type": "range",
        "id": "layout_page_width",
        "label": "Ancho máximo del contenido",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1280
      },
      {
        "type": "range",
        "id": "layout_spacing_sections",
        "label": "Espaciado vertical entre secciones",
        "min": 24,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 64
      },
      {
        "type": "range",
        "id": "layout_grid_gap",
